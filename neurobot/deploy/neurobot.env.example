# neurobot: единый env-файл робота -> /etc/neurobot/neurobot.env (install.sh --env этот_файл).
# Синтаксис systemd EnvironmentFile=: ИМЯ=значение, значение с пробелами — в "…"; комментарий — только целой
# строкой (# в конце строки попадёт в значение); подстановок $VAR нет. Пользователь, группы и путь установки
# подставляются в юниты при install.sh — после их правки установку повторить.
# Значения с пометкой «уточнить» — по ответам лаборатории (ANALYSIS §5, R7 §7); описание всех ключей — README.md.

# --- кто и где -------------------------------------------------------------------------------------------------
NEUROBOT_USER=jetson
NEUROBOT_GROUP=jetson
# dialout — последовательные порты (лидар, STM32); video, plugdev — камера (правила udev librealsense)
NEUROBOT_SUPPLEMENTARY_GROUPS="dialout video plugdev"
NEUROBOT_PREFIX=/opt/neurobot

# --- состав: компоненты в порядке запуска, драйверы и воркеры лаборатории -------------------------------------
NEUROBOT_COMPONENTS="safety executor perception rosbridge mcp picoclaw"
NEUROBOT_DRIVERS="lidar base camera imu"
NEUROBOT_LABWORKERS=

# --- ROS 2 Foxy ------------------------------------------------------------------------------------------------
NEUROBOT_ROS_SETUP=/opt/ros/foxy/setup.bash
# рабочее пространство лаборатории (ros2_control, twist_mux, мост к STM32) и пакета neurobot (уточнить)
NEUROBOT_ROS_OVERLAY=
ROS_DOMAIN_ID=0
# ROS_LOCALHOST_ONLY=1 не ставим: у лаборатории RViz и геймпад на ПК по DDS (RS11); включать — только по согласию

# --- драйверы лаборатории (уточнить: R7 §7 п. 3 — какие launch-файлы и кем запускаются) ---------------------------
# ros2 launch — через обёртку deploy supervised.launch.py (include:=пакет/файл, прочие аргументы — как были): смерть
# любого узла внутри launch гасит его, и юнит поднимает systemd; без неё юнит остаётся active без узла (precheck
# предупреждает). Зависший узел (жив, но молчит) ловит сторож: тема NEUROBOT_DRIVER_<имя>_FRESH (по умолчанию — тема
# готовности TOPIC с NEUROBOT_WATCHDOG_STALE_S) старше предела две пробы подряд — restart юнита
# Лидар URG-04LX (urg_node2, frame laser_frame): один экземпляр — в графе робота 02.06 было два /urg_node2 (N13)
NEUROBOT_DRIVER_lidar_CMD="ros2 launch /opt/neurobot/share/launchfiles/supervised.launch.py include:=urg_node2/urg_node2.launch.py"
NEUROBOT_DRIVER_lidar_DEVICE=/dev/ttyACM0
NEUROBOT_DRIVER_lidar_TOPIC=/scan
# База: ros2_control + diff_drive_controller (diff_cont) + joint_state_broadcaster + twist_mux:
# /cmd_vel -> twist_mux -> /diff_cont/cmd_vel_unstamped -> STM32 по UART. Камеру, фильтр IMU и rosbridge этот launch
# запускать не должен: у них свои юниты ниже (два узла камеры — второй не откроет устройство; rosbridge — port_busy)
# spawner контроллеров завершается сам с кодом 0 — обёртка это знает (oneshot:=spawner,spawner.py,create)
NEUROBOT_DRIVER_base_CMD="ros2 launch /opt/neurobot/share/launchfiles/supervised.launch.py include:=ПАКЕТ_ЛАБОРАТОРИИ/LAUNCH_БАЗЫ"
NEUROBOT_DRIVER_base_DEVICE=/dev/ttyUSB0
NEUROBOT_DRIVER_base_TOPIC=/odom
# Свежесть базы для сторожа: /odom и статус twist_mux в /diagnostics (раз в 1 с из того же исполнителя, что и
# команды: twist_mux завис — статус молчит, база перезапускается). Пока статуса twist_mux не было ни разу (другая
# версия без диагностики), сторож по нему не судит
NEUROBOT_DRIVER_base_FRESH="/odom:2 /diagnostics@twist_mux:3"
# Камера D435i — realsense2_camera (узел /camera/camera, как в графе робота 02.06): цвет для распознавания
# (--camera ros), глубина и IMU для safety_gate (PLAN §13.3). Параметры — realsense-ros 4.51.1 для Foxy (уточнить
# версию: в 3.x unite_imu_method:=linear_interpolation и depth_width/depth_height/depth_fps, color_* вместо profile);
# экспозиция цвета — README распознавания. Профили — явно, а не умолчания устройства (по 30 к/с):
# - глубина 848×480 (как по умолчанию), 15 к/с: safety_gate обрабатывает ≤ 10 кадров/с, разбор в Python — до
#   24,4 → 12,2 МБ/с [расчёт]; 424×240 против 848×480 с прореживанием — A/B на роботе (шум пола, CPU; RUNBOOK §9);
# - цвет 640×480, 15 к/с — темп детектора на Nano (≤ 15 кадров/с): 27,6 → 13,8 МБ/с [расчёт]; после TensorRT — заново;
# - IMU: гироскоп 200 Гц, акселерометр 250 Гц (оба склеиваются в /camera/imu с частотой гироскопа): удар safety_gate
#   ловит по ускорению, а на 63 Гц короткий всплеск сглаживается; порог shock_mps2 — по записи на роботе (RUNBOOK §9)
NEUROBOT_DRIVER_camera_CMD="ros2 launch /opt/neurobot/share/launchfiles/supervised.launch.py include:=realsense2_camera/rs_launch.py depth_module.profile:=848x480x15 rgb_camera.profile:=640x480x15 enable_gyro:=true enable_accel:=true gyro_fps:=200 accel_fps:=250 unite_imu_method:=2"
NEUROBOT_DRIVER_camera_TOPIC=/camera/color/image_raw
# сторож смотрит camera_info: он приходит с каждым кадром цвета, а копия самих кадров raw стоила бы ≈13 МБ/с
# [замер, двойник, 640×480×15]
NEUROBOT_DRIVER_camera_FRESH="/camera/color/camera_info:2"
# камера на USB перед стартом драйвера (нет — camera_missing у драйвера, а не тишина темы через 30 с)
NEUROBOT_DRIVER_camera_USB=8086:0b3a
# Ориентация по IMU камеры: imu_filter_madgwick (/imu_filter_madgwick в графе робота) /camera/imu -> /imu/data.
# publish_tf:=false: иначе он шлёт TF odom → кадр IMU с частотой IMU (≈192 Гц [замер, двойник]) — у кадра IMU второй
# родитель, лишний поток /tf; на двойнике флаг стоит с самого начала
NEUROBOT_DRIVER_imu_CMD="ros2 run imu_filter_madgwick imu_filter_madgwick_node --ros-args -r imu/data_raw:=/camera/imu -p use_mag:=false -p publish_tf:=false"
NEUROBOT_DRIVER_imu_TOPIC=/imu/data

# --- компоненты ------------------------------------------------------------------------------------------------
# safety_gate (neurobot/safety: install.sh ставит его в <prefix>/src, юнит добавляет к PYTHONPATH) — единственный
# писатель /cmd_vel; тип /cmd_vel на роботе — Twist (вход twist_mux)
# agent_state_topic — копия /neurobot/safety_state для агента: rosbridge 1.3.1 не умеет открыть тему только на чтение,
# а сам /neurobot/safety_state читают исполнитель, doctor и neurobot estop (NEUROBOT_AGENT_STATE_TOPIC — та же тема)
NEUROBOT_SAFETY_CMD="/usr/bin/python3 -m neurobot.safety --ros-args -p agent_state_topic:=/neurobot/agent/safety_state"
NEUROBOT_SAFETY_MODULES="numpy<2 rclpy"
# Исполнитель (пакет 1 — страж v1, neurobot/executor): его /cmd_vel ремапится во вход safety_gate (ремап обязателен:
# без него precheck откажет; исполнителю, который /cmd_vel не пишет, он ничего не меняет)
NEUROBOT_EXECUTOR_CMD="/usr/bin/python3 -m neurobot.executor --ros-args -p cmd_vel_type:=Twist -r /cmd_vel:=/neurobot/cmd_vel_req"
# predict_live v2 (патч в их репозитории) в режиме legacy: свой DriveController пишет не в /cmd_vel, а в
# /cmd_vel_gesture (ремап обязателен — без него precheck откажет). --camera ros: кадры из темы драйвера камеры;
# своя камера (--camera rs) — только без драйвера camera, и тогда у safety_gate нет глубины и IMU.
# Python 3.8 с torch 1.13 — тот, где работает демо (уточнить: pyenv-шим не годится, N6)
NEUROBOT_PERCEPTION_CMD="/usr/bin/python3 /home/jetson/NeuroChip/demo/src/camera/predict_live.py --mode legacy --camera ros --ros-args -r /cmd_vel:=/cmd_vel_gesture"
NEUROBOT_PERCEPTION_MODULES="numpy<2 torch snntorch pyrealsense2 cv2 rclpy"
# rosbridge только на 127.0.0.1 (без address слушает все интерфейсы) и со списками разрешённого (L3), каждый аргумент —
# один раз (при повторе ros2 launch берёт последнее значение): topics_glob — только тема агента, копия состояния
# safety_gate для агента и стоп агента (тема из списка открыта клиентам и на запись: /cmd_vel, вход safety_gate,
# защёлка, датчики и прочие /neurobot/* в него нельзя; копию читает только MCP-сервер — подменить её агент может лишь
# себе; стоп агента умеет только остановить);
# services_glob — только /rosapi/… (их rosbridge при любом services_glob пропускает сам; без глоба открыты
# set_parameters у safety_gate, diff_cont, twist_mux, драйверов и /controller_manager/*); params_glob — none, ни
# одного параметра (/rosapi/set_param меняет параметры любого узла). Кавычки YAML вокруг списков обязательны: без них
# ros2 launch передаст массив строк, и rosbridge не стартует
NEUROBOT_ROSBRIDGE_CMD="ros2 launch /opt/neurobot/share/launchfiles/supervised.launch.py include:=rosbridge_server/rosbridge_websocket_launch.xml address:=127.0.0.1 port:=9090 topics_glob:=\"'[/cmd_vel_agent,/neurobot/agent/safety_state,/neurobot/stop_now]'\" services_glob:=\"'[/rosapi/topics]'\" params_glob:=\"'[none]'\""
NEUROBOT_ROSBRIDGE_PORT=9090
# Агентский MCP-сервер, вариант А (по умолчанию): ros_mcp_server лаборатории с патчем neurobot — пишет во вход
# исполнителя /cmd_vel_agent через rosbridge; отдельное окружение Python >= 3.10 (на 3.8 не запустится, M13)
NEUROBOT_MCP_CMD="/opt/ros-mcp/.venv/bin/python /opt/ros-mcp/ros_mcp_server.py --config /etc/neurobot/ros_mcp.json"
NEUROBOT_MCP_CONFIG=/etc/neurobot/ros_mcp.json
NEUROBOT_MCP_MODULES="python>=3.10 mcp>=1.8 websocket"
NEUROBOT_MCP_URL=http://127.0.0.1:18110/mcp
NEUROBOT_MCP_STATUS_TOOL=robot_get_status
# Вариант Б: прокси лаборатории robot_vision_mcp_proxy.py с патчем neurobot и её воркер 8766 под супервизией.
# Код воркера 8766 не прислан: куда он пишет скорость и открывает ли камеру сам — уточнить (R7 §7 п. 1); если пишет
# /cmd_vel — safety_gate не стартует (cmd_vel_writer), если открывает камеру — NEUROBOT_LABWORKER_vision_CAMERA=yes и
# без perception.
# NEUROBOT_LABWORKERS=vision
# NEUROBOT_LABWORKER_vision_CMD="/usr/bin/python3 /home/jetson/NeuroChip/ВОРКЕР_8766.py"
# NEUROBOT_LABWORKER_vision_URL=http://127.0.0.1:8766/state
# NEUROBOT_LABWORKER_vision_MODULES="numpy<2 torch cv2 rclpy"
# NEUROBOT_MCP_CMD="/home/jetson/NeuroChip/yolo_mcp_server/.venv/bin/python3 /home/jetson/NeuroChip/yolo_mcp_server/robot_vision_mcp_proxy.py"
# NEUROBOT_MCP_CONFIG=
# NEUROBOT_MCP_MODULES="python>=3.10 mcp>=1.8"
# NEUROBOT_MCP_STATUS_TOOL=robot_demo_get_status
# ROBOT_VISION_MCP_PORT=18110
# ROBOT_VISION_MAX_DURATION_S=0.5
# ROBOT_VISION_MAX_SPEED=0.25
# PicoClaw лаборатории (на роботе 0.2.8); версию берём из «picoclaw version», можно задать явно
NEUROBOT_PICOCLAW_CMD="/usr/local/bin/picoclaw --no-color gateway"
NEUROBOT_PICOCLAW_PORT=18790
NEUROBOT_PICOCLAW_VERSION=
PICOCLAW_HOME=/home/jetson/.picoclaw
# Пульт оператора (neurobot/ui; компонент ui — только по согласию лаборатории, в состав выше не входит): шлюз
# rclpy + HTTP на 127.0.0.1:NEUROBOT_UI_PORT, вход — SSH-туннель и ссылка «sudo neurobot ui-url». Пишет только
# /neurobot/stop_now и /neurobot/estop {engage}; снять защёлку из пульта нельзя. Свой пользователь (install.sh создаёт)
NEUROBOT_UI_CMD="/usr/bin/python3 -m neurobot.ui live"
NEUROBOT_UI_USER=neurobot-ui
NEUROBOT_UI_PORT=18120
NEUROBOT_UI_SOURCE=робот
NEUROBOT_UI_DOCTOR_S=60

# --- темы (как на роботе, R7 §1.5) -----------------------------------------------------------------------------
NEUROBOT_CMD_VEL=/cmd_vel
NEUROBOT_CMD_VEL_TYPE=geometry_msgs/msg/Twist
NEUROBOT_CMD_VEL_REQ=/neurobot/cmd_vel_req
NEUROBOT_AGENT_TOPIC=/cmd_vel_agent
NEUROBOT_MUX_NODE=twist_mux
NEUROBOT_BASE_CMD_TOPIC=/diff_cont/cmd_vel_unstamped
# входы twist_mux: /cmd_vel_tracker главнее /cmd_vel (его издатель перекрывает ноль safety_gate), /cmd_vel_joy — геймпад
NEUROBOT_OVERRIDE_TOPICS=/cmd_vel_tracker
NEUROBOT_JOY_TOPICS=/cmd_vel_joy
NEUROBOT_SCAN_TOPIC=/scan
NEUROBOT_SCAN_FRAME=laser_frame
# Датчики для doctor «тема:тип[:мин_Гц]» (темы робота, R7a): база (diff_cont, joint_state_broadcaster), камера и IMU
# (realsense2_camera, imu_filter_madgwick). Пороги — с запасом вниз от номинала (цвет и глубина 15 к/с, IMU 200 Гц
# при unite_imu_method), чтобы медленный приём в doctor не давал ложных sensor_stale [оценка; уточнить по launch]
NEUROBOT_SENSORS="/odom:nav_msgs/msg/Odometry:10 /tf:tf2_msgs/msg/TFMessage /joint_states:sensor_msgs/msg/JointState:10 /camera/color/image_raw:sensor_msgs/msg/Image:5 /camera/depth/image_rect_raw:sensor_msgs/msg/Image:5 /camera/imu:sensor_msgs/msg/Imu:50 /imu/data:sensor_msgs/msg/Imu:50"
NEUROBOT_HEALTH_TOPIC=/neurobot/perception_health
NEUROBOT_MOTION_STATE_TOPIC=/neurobot/motion_state
NEUROBOT_SAFETY_STATE_TOPIC=/neurobot/safety_state
NEUROBOT_ESTOP_TOPIC=/neurobot/estop
# снятие защёлки — только sudo neurobot estop release: файл root в этом каталоге (= release_dir safety_gate)
NEUROBOT_ESTOP_RELEASE_DIR=/run/neurobot-estop
NEUROBOT_AGENT_STATE_TOPIC=/neurobot/agent/safety_state
# стоп агента (robot_stop через MCP, решение 1а): safety_gate ставит ноль сразу, без защёлки; тема — в topics_glob
# rosbridge и в topics.stop_now конфига MCP
NEUROBOT_STOP_TOPIC=/neurobot/stop_now
NEUROBOT_SAFETY_NODE=safety_gate
NEUROBOT_EXECUTOR_NODE=motion_executor
NEUROBOT_PERCEPTION_NODE=velocity_publisher

# --- пределы агентских инструментов (L3): сверяются с конфигом MCP-сервера и патчем прокси ---------------------
NEUROBOT_AGENT_MAX_SPEED=0.15
NEUROBOT_AGENT_MAX_TURN=0.8
NEUROBOT_AGENT_MAX_DURATION_S=1.0

# --- проверки перед стартом ------------------------------------------------------------------------------------
# D435i; D435 — 8086:0b07 (можно через запятую)
NEUROBOT_CAMERA_USB=8086:0b3a
NEUROBOT_WEIGHTS=/etc/neurobot/weights.sha256
NEUROBOT_WAIT_S=30
NEUROBOT_LABWORKER_WAIT_S=170
NEUROBOT_WRITER_CHECK_S=0.75
NEUROBOT_PRECHECK_BACKOFF_S=5
NEUROBOT_WATCHDOG_PERIOD_S=10
# частые пробы сторожа: свежесть тем драйверов и ping rosbridge раз в FAST_S; тема старше STALE_S (если у драйвера нет
# своего FRESH) две пробы подряд — restart драйвера [допущение: пороги до замера на Nano]
NEUROBOT_WATCHDOG_FAST_S=1
NEUROBOT_WATCHDOG_STALE_S=2
