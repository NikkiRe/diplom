# Драйвер лаборатории (лидар urg_node2; база: ros2_control + diff_drive_controller + twist_mux; камера), экземпляр
# neurobot-driver@<имя>.
# Команда — NEUROBOT_DRIVER_<имя>_CMD; проверка перед стартом — устройство NEUROBOT_DRIVER_<имя>_DEVICE и id на USB
# NEUROBOT_DRIVER_<имя>_USB (камера); тема готовности (ждём первое сообщение) — NEUROBOT_DRIVER_<имя>_TOPIC. Всё — в
# @ETC@/neurobot.env.
[Unit]
Description=neurobot: драйвер %i
Documentation=file:@PREFIX@/share/RUNBOOK.md
PartOf=neurobot.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=@USER@
Group=@GROUP@
SupplementaryGroups=@SUPPLEMENTARY_GROUPS@
EnvironmentFile=@ETC@/neurobot.env
Environment=NEUROBOT_ENV=@ETC@/neurobot.env ROS_LOG_DIR=/run/neurobot/%N
# журналы rcl — в tmpfs: у системного пользователя может не быть $HOME, а всё нужное и так в journald
RuntimeDirectory=neurobot/%N
ExecStartPre=@PREFIX@/bin/neurobot precheck driver@%i
ExecStart=@PREFIX@/bin/neurobot-run --ros --var NEUROBOT_DRIVER_%i_CMD
ExecStartPost=@PREFIX@/bin/neurobot wait-topic driver@%i
# ros2 run/launch корректно гасят дочерние узлы по SIGINT
KillSignal=SIGINT
Restart=always
RestartSec=1
TimeoutStartSec=60
TimeoutStopSec=10
LogRateLimitIntervalSec=30s
LogRateLimitBurst=2000

[Install]
WantedBy=neurobot.target
