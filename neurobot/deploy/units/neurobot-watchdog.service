# Сторож (root: systemctl restart, журнал): свежесть тем драйверов и ping rosbridge — часто, проба MCP и журнал
# PicoClaw без хода LLM — раз в период. Стартует вместе с драйверами, без After=: иначе его старт ждал бы, пока
# поднимется весь агентский путь, а зависший драйвер камеры, из-за которого не поднимается распознавание, некому
# было бы перезапустить. Юниты моложе пробы он и так не трогает. Долгоживущий сервис, а не таймер: на systemd 245
# таймер раз в 10 с даёт две строки systemd на запуск.
[Unit]
Description=neurobot: сторож драйверов, rosbridge, MCP-сервера и PicoClaw
Documentation=file:@PREFIX@/share/RUNBOOK.md
PartOf=neurobot.target
StartLimitIntervalSec=0

[Service]
Type=exec
EnvironmentFile=@ETC@/neurobot.env
Environment=NEUROBOT_ENV=@ETC@/neurobot.env
ExecStart=@PREFIX@/bin/neurobot watchdog
Restart=always
RestartSec=5
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=neurobot.target
