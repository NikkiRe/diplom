# Сторож агентского контура (root: systemctl restart, журнал): проба MCP и журнал PicoClaw без хода LLM.
# Долгоживущий сервис, а не таймер: на systemd 245 таймер раз в 10 с даёт две строки systemd на запуск.
[Unit]
Description=neurobot: сторож MCP-сервера и PicoClaw
Documentation=file:@PREFIX@/share/RUNBOOK.md
PartOf=neurobot.target
After=neurobot-mcp.service neurobot-picoclaw.service
StartLimitIntervalSec=0

[Service]
Type=exec
EnvironmentFile=@ETC@/neurobot.env
Environment=NEUROBOT_ENV=@ETC@/neurobot.env
ExecStart=@PREFIX@/bin/neurobot watchdog
Restart=always
RestartSec=5
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=neurobot.target
