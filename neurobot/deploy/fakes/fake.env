# Профиль «подставные компоненты» для проверки запуска на стенде (ВМ sim, Jazzy) без робота: те же юниты,
# install.sh и doctor, вместо компонентов — fake_component.py. Отдельный DDS-домен и порты, чтобы не мешать стенду.
# Ставится setup_stand.sh (он же создаёт подставные /sys с камерой и файлы весов).
NEUROBOT_USER=neurobot
NEUROBOT_GROUP=neurobot
NEUROBOT_SUPPLEMENTARY_GROUPS=
NEUROBOT_PREFIX=/opt/neurobot
NEUROBOT_COMPONENTS="safety executor perception rosbridge mcp picoclaw"
NEUROBOT_DRIVERS="urg base"
NEUROBOT_LABWORKERS="vision"
NEUROBOT_ROS_SETUP=/opt/ros/jazzy/setup.bash
NEUROBOT_ROS_OVERLAY=
ROS_DOMAIN_ID=77
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
NEUROBOT_DRIVER_urg_CMD="/usr/bin/python3 /opt/neurobot/lib/fakes/fake_component.py driver --topic /scan"
NEUROBOT_DRIVER_urg_TOPIC=/scan
# «база»: узел twist_mux (/cmd_vel -> /diff_cont/cmd_vel_unstamped) и датчики NEUROBOT_SENSORS
NEUROBOT_DRIVER_base_CMD="/usr/bin/python3 /opt/neurobot/lib/fakes/fake_component.py base"
NEUROBOT_DRIVER_base_TOPIC=/odom
NEUROBOT_SENSORS="/odom:nav_msgs/msg/Odometry:10 /tf:tf2_msgs/msg/TFMessage /joint_states:sensor_msgs/msg/JointState:5 /camera/color/image_raw:sensor_msgs/msg/Image:5 /camera/depth/image_rect_raw:sensor_msgs/msg/Image:5 /camera/imu:sensor_msgs/msg/Imu:20 /imu/data:sensor_msgs/msg/Imu:20"
NEUROBOT_SAFETY_CMD="/usr/bin/python3 /opt/neurobot/lib/fakes/fake_component.py safety"
# исполнитель и распознавание, как настоящие, пишут «/cmd_vel» сами — в сторону его уводит ремап (как на роботе)
NEUROBOT_EXECUTOR_CMD="/usr/bin/python3 /opt/neurobot/lib/fakes/fake_component.py executor --ros-args -r /cmd_vel:=/neurobot/cmd_vel_req"
NEUROBOT_PERCEPTION_CMD="/usr/bin/python3 /opt/neurobot/lib/fakes/fake_component.py perception --warmup 2 --ros-args -r /cmd_vel:=/cmd_vel_gesture"
# подставному распознаванию нужен только rclpy (проверка интерпретатора — та же, что на роботе)
NEUROBOT_PERCEPTION_MODULES=rclpy
NEUROBOT_ROSBRIDGE_CMD="/usr/bin/python3 /opt/neurobot/lib/fakes/fake_component.py rosbridge address:=127.0.0.1 topics_glob:=\"'[/cmd_vel_agent]'\" services_glob:=\"'[/rosapi/topics]'\" params_glob:=\"'[none]'\""
NEUROBOT_ROSBRIDGE_PORT=19090
# «загрузка модели» 3 с: порт открыт сразу, /health отвечает 503, затем 200
NEUROBOT_LABWORKER_vision_CMD="/usr/bin/python3 /opt/neurobot/lib/fakes/fake_component.py worker --name vision --warmup 3"
NEUROBOT_LABWORKER_vision_URL=http://127.0.0.1:18766/health
NEUROBOT_LABWORKER_vision_MODULES=json
NEUROBOT_LABWORKER_WAIT_S=30
NEUROBOT_MCP_CMD="/usr/bin/python3 /opt/neurobot/lib/fakes/fake_component.py mcp"
NEUROBOT_MCP_CONFIG=/etc/neurobot/ros_mcp.json
NEUROBOT_MCP_MODULES="python>=3.10"
NEUROBOT_MCP_URL=http://127.0.0.1:18118/mcp
NEUROBOT_PICOCLAW_CMD="/usr/bin/python3 /opt/neurobot/lib/fakes/fake_component.py picoclaw --tool-every 20"
NEUROBOT_PICOCLAW_PORT=18797
NEUROBOT_PICOCLAW_VERSION=0.3.1
PICOCLAW_CONFIG=/etc/neurobot/picoclaw.json
NEUROBOT_CMD_VEL=/cmd_vel
NEUROBOT_CMD_VEL_TYPE=geometry_msgs/msg/Twist
NEUROBOT_CAMERA_USB=8086:0b3a
NEUROBOT_SYSFS=/var/lib/neurobot-fake/sys
NEUROBOT_WEIGHTS=/etc/neurobot/weights.sha256
NEUROBOT_WAIT_S=30
NEUROBOT_WRITER_CHECK_S=0.75
NEUROBOT_PRECHECK_BACKOFF_S=5
NEUROBOT_WATCHDOG_PERIOD_S=10
# на стенде рядом может идти прогон настоящего predict_live.py (другой домен DDS) — его не считаем чужим
NEUROBOT_FOREIGN_PERCEPTION=realsense-viewer
