# Профиль «цифровой двойник» (neurobot/sim/suites, README §2): пакет neurobot целиком на двойнике в ВМ sim, как на
# роботе — те же юниты, install.sh, precheck и doctor. Драйверы лаборатории заменяют три экземпляра neurobot-driver@,
# как на роботе отдельными юнитами: twin — Gazebo, ros2_control с diff_cont, twist_mux, madgwick (база и фильтр IMU),
# lidar — узел /urg_node2, camera — узел /camera/camera (как realsense2_camera: цвет, глубина, IMU камеры).
# Ставит setup_twin.sh: код — ВМ-локальный снимок проекта в /var/lib/neurobot-twin/src; домен DDS и мир — его флаги.
# Синтаксис — systemd EnvironmentFile= (README deploy, «env-файл»). Переменные файла перекрывают Environment= юнитов,
# поэтому PYTHONPATH здесь включает и код safety_gate и исполнителя (/opt/neurobot/src).
NEUROBOT_USER=neurobot
NEUROBOT_GROUP=neurobot
NEUROBOT_SUPPLEMENTARY_GROUPS=
NEUROBOT_PREFIX=/opt/neurobot
NEUROBOT_COMPONENTS="safety executor perception rosbridge mcp picoclaw"
NEUROBOT_DRIVERS="twin lidar camera"
NEUROBOT_LABWORKERS=
NEUROBOT_ROS_SETUP=/opt/ros/jazzy/setup.bash
NEUROBOT_ROS_OVERLAY=
ROS_DOMAIN_ID=23
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///var/lib/neurobot-twin/src/scripts/sim/cyclonedds.xml
# Gazebo в ВМ без GPU: программный рендеринг; ~/.gz — в каталоге системного пользователя
LIBGL_ALWAYS_SOFTWARE=1
GALLIUM_DRIVER=llvmpipe
LIBGL_DRI3_DISABLE=1
QT_QPA_PLATFORM=offscreen
HOME=/var/lib/neurobot-twin/home
PYTHONDONTWRITEBYTECODE=1
PYTHONPATH=/opt/neurobot/src:/var/lib/neurobot-twin/src:/var/lib/neurobot-twin/src/neurobot/sim/gestures/shim

# --- «драйверы»: Gazebo и база (twin), лидар, камера — как юниты драйверов робота, ros2 launch через обёртку deploy -
# twin: gz_ros2_control (diff_cont, joint_broad), twist_mux, madgwick; датчики — не здесь (sensors:=outside), а в своих
# юнитах; rosbridge двойника выключен: у пакета свой юнит. Готовность — первый /odom (контроллер активен, цепочка связана)
NEUROBOT_DRIVER_twin_CMD="ros2 launch /opt/neurobot/share/launchfiles/supervised.launch.py include:=/var/lib/neurobot-twin/src/neurobot/sim/twin/launch/twin.launch.py run_dir:=/var/lib/neurobot-twin/run rosbridge:=false sensors:=outside world:=lab"
NEUROBOT_DRIVER_twin_TOPIC=/odom
NEUROBOT_DRIVER_twin_FRESH="/odom:3"
# лидар: /scan, «нет отражения» — NaN (допущение двойника о urg_node2; no_return:=inf — по REP 117)
NEUROBOT_DRIVER_lidar_CMD="ros2 launch /opt/neurobot/share/launchfiles/supervised.launch.py include:=/var/lib/neurobot-twin/src/neurobot/sim/twin/launch/sensor.launch.py role:=lidar no_return:=nan"
NEUROBOT_DRIVER_lidar_TOPIC=/scan
# камера: цвет, глубина, IMU камеры; готовность — первый кадр цвета (мост ленивый: кадры идут, пока есть подписчик)
NEUROBOT_DRIVER_camera_CMD="ros2 launch /opt/neurobot/share/launchfiles/supervised.launch.py include:=/var/lib/neurobot-twin/src/neurobot/sim/twin/launch/sensor.launch.py role:=camera"
NEUROBOT_DRIVER_camera_TOPIC=/camera/color/image_raw
NEUROBOT_SENSORS="/odom:nav_msgs/msg/Odometry:10 /tf:tf2_msgs/msg/TFMessage /joint_states:sensor_msgs/msg/JointState:10 /camera/color/image_raw:sensor_msgs/msg/Image:5 /camera/depth/image_rect_raw:sensor_msgs/msg/Image:5 /camera/imu:sensor_msgs/msg/Imu:50 /imu/data:sensor_msgs/msg/Imu:50"

# --- компоненты: как в neurobot.env.example, кроме путей ----------------------------------------------------------
NEUROBOT_SAFETY_CMD="/usr/bin/python3 -m neurobot.safety"
# Jazzy (rosbridge 2.x): агент читает /neurobot/safety_state только на чтение (topics_sub_glob ниже) — копия не нужна
NEUROBOT_SAFETY_MODULES="numpy<2 rclpy"
NEUROBOT_EXECUTOR_CMD="/usr/bin/python3 -m neurobot.executor --ros-args -p cmd_vel_type:=Twist -r /cmd_vel:=/neurobot/cmd_vel_req"
# perception v2: кадры камеры Gazebo (--camera ros, как realsense2_camera на роботе), руку даёт FakeYolo по таймлайну
# gesturegen (руки в кадре Gazebo нет), SNN лаборатории — torch CPU, веса weights_only. --polyline — флаг perception
# под A/B: с предобработкой лаборатории SNN почти всегда «немая» (G1), и жест не дал бы движения
NEUROBOT_PERCEPTION_CMD="/var/lib/neurobot-twin/venv/bin/python /var/lib/neurobot-twin/src/neurobot/perception/predict_live.py --mode legacy --camera ros --yolo fake --polyline --snn-weights /var/lib/neurobot-twin/models/snn_emnist_small.pth --ros-args -r /cmd_vel:=/cmd_vel_gesture"
NEUROBOT_PERCEPTION_MODULES="numpy<2 torch snntorch cv2 rclpy pyrealsense2"
NEUROBOT_GESTURES_TIMELINE=/var/lib/neurobot-twin/gestures/timeline.jsonl
NEUROBOT_GESTURES_ANCHOR=/var/lib/neurobot-twin/gestures/anchor.json
NEUROBOT_ROSBRIDGE_CMD="ros2 launch /opt/neurobot/share/launchfiles/supervised.launch.py include:=rosbridge_server/rosbridge_websocket_launch.xml address:=127.0.0.1 port:=9123 topics_glob:=\"'[/cmd_vel_agent]'\" topics_sub_glob:=\"'[/neurobot/safety_state]'\" services_glob:=\"'[/rosapi/topics]'\" params_glob:=\"'[none]'\""
NEUROBOT_ROSBRIDGE_PORT=9123
# агентский путь, вариант А: ros_mcp_server лаборатории с патчем neurobot (Python 3.12 с mcp)
NEUROBOT_MCP_CMD="/var/lib/neurobot-twin/mcpvenv/bin/python /var/lib/neurobot-twin/ros-mcp/ros_mcp_server.py --config /etc/neurobot/ros_mcp.json"
NEUROBOT_MCP_CONFIG=/etc/neurobot/ros_mcp.json
NEUROBOT_MCP_MODULES="python>=3.10 mcp>=1.8 websocket"
NEUROBOT_MCP_URL=http://127.0.0.1:18123/mcp
NEUROBOT_MCP_STATUS_TOOL=robot_get_status
# PicoClaw 0.2.8 linux-arm64, как на роботе; LLM — bench/mockllm на 127.0.0.1:18124 (0 ₽, ключей нет)
NEUROBOT_PICOCLAW_CMD="/var/lib/neurobot-twin/picoclaw-bin --no-color gateway"
NEUROBOT_PICOCLAW_PORT=18793
NEUROBOT_PICOCLAW_VERSION=
PICOCLAW_HOME=/var/lib/neurobot-twin/picoclaw

# --- темы (как на роботе) -----------------------------------------------------------------------------------------
NEUROBOT_CMD_VEL=/cmd_vel
NEUROBOT_CMD_VEL_TYPE=geometry_msgs/msg/Twist
NEUROBOT_CMD_VEL_REQ=/neurobot/cmd_vel_req
NEUROBOT_AGENT_TOPIC=/cmd_vel_agent
NEUROBOT_MUX_NODE=twist_mux
NEUROBOT_BASE_CMD_TOPIC=/diff_cont/cmd_vel_unstamped
NEUROBOT_OVERRIDE_TOPICS=/cmd_vel_tracker
NEUROBOT_JOY_TOPICS=/cmd_vel_joy
NEUROBOT_SCAN_TOPIC=/scan
NEUROBOT_SCAN_FRAME=laser_frame
NEUROBOT_SAFETY_NODE=safety_gate
NEUROBOT_EXECUTOR_NODE=motion_executor
NEUROBOT_PERCEPTION_NODE=velocity_publisher
NEUROBOT_AGENT_MAX_SPEED=0.15
NEUROBOT_AGENT_MAX_TURN=0.8
NEUROBOT_AGENT_MAX_DURATION_S=1.0

# --- проверки перед стартом ---------------------------------------------------------------------------------------
# камеры на USB у двойника нет: подставной sysfs с id D435i, как у стенда deploy (проверка остаётся в цепочке)
NEUROBOT_CAMERA_USB=8086:0b3a
NEUROBOT_SYSFS=/var/lib/neurobot-twin/sys
NEUROBOT_WEIGHTS=/etc/neurobot/weights.sha256
NEUROBOT_WAIT_S=45
NEUROBOT_WRITER_CHECK_S=0.75
NEUROBOT_PRECHECK_BACKOFF_S=5
NEUROBOT_WATCHDOG_PERIOD_S=10
# ВМ общая: прогоны perception, демо и MCP-серверов других стендов (свои домен DDS и порты) — не чужие владельцы
# камеры и не второй агентский сервер; ros_mcp_server.py других стендов из списка убран
NEUROBOT_FOREIGN_PERCEPTION=realsense-viewer
NEUROBOT_FOREIGN_MCP="start_robot_mcp.sh robot_vision_mcp_proxy.py yolo_mcp_server.py run_yolo_mcp_stack.sh yolo_hand_worker.py"
