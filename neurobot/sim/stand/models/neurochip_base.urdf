<?xml version="1.0"?>
<!-- Кадры базы NeuroChip для robot_state_publisher стенда; геометрия и её источники — neurochip_base.sdf.
     Имена кадров — как на роботе там, где они известны (laser_frame — frame_id /scan с робота, R7). -->
<robot name="neurochip_base">
  <link name="base_footprint"/>
  <link name="base_link"/>
  <link name="wheel_left_link"/>
  <link name="wheel_right_link"/>
  <link name="laser_frame"/>
  <link name="imu_link"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
  </joint>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_left_link"/>
    <origin xyz="0 0.19 0.036" rpy="-1.5707963 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_right_link"/>
    <origin xyz="0 -0.19 0.036" rpy="-1.5707963 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_frame"/>
    <origin xyz="-0.015 0 0.67" rpy="0 0 0"/>
  </joint>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.0455 -0.04175 0.6495" rpy="0 0 0"/>
  </joint>
</robot>
