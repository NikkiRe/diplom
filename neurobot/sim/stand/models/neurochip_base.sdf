<?xml version="1.0"?>
<!-- База робота NeuroChip для стенда (stand.sh up, база neurochip; neurobot/sim/stand/README.md §2).
     Все размеры — оценка по фото из презентации «Робот-сканер» (docs/neurobot/research/R7_robot_slides.md §2.3,
     точность там же); масса — оценка по составу, усилие мотора — оценка. Заменить на URDF лаборатории, когда пришлют.
     Начало координат — на полу под центром палуб; x — вперёд (куда смотрит камера), z — вверх.
       палубы: круг Ø0,39 м, от 0,05 до 0,175 м (одна коллизия); ведущие колёса Ø0,072 на оси через центр, колея 0,38;
       ролики спереди и сзади (x = ±0,15) — сферы без трения; мачта (телескоп, ось x = −0,015) до 0,62 м;
       голова с ЖК 0,535–0,62 м; URG-04LX: плоскость скана 0,67 м, корпус 0,618–0,688 м; D435i в 48 мм перед осью
       лидара.
     Визуальные формы (по ним считает gpu_lidar) не пересекают плоскость скана: корпус D435i опущен под неё, а затенение
     лидара камерой (R7b RS3) включается флагом стенда scan_occluder — NaN, как у urg_node2, а не 5 см до корпуса.
     Темы gz — как у TurtleBot3 waffle_pi (мост turtlebot3_gazebo без изменений); сенсор imu нужен robot_sim.launch.py. -->
<sdf version="1.8">
  <model name="neurochip_base">
    <link name="base_link">
      <inertial>
        <pose>0 0 0.2 0 0 0</pose>
        <mass>3.8</mass>
        <inertia><ixx>0.15</ixx><iyy>0.15</iyy><izz>0.075</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="decks">
        <pose>0 0 0.1125 0 0 0</pose>
        <geometry><cylinder><radius>0.195</radius><length>0.125</length></cylinder></geometry>
      </collision>
      <visual name="decks">
        <pose>0 0 0.1125 0 0 0</pose>
        <geometry><cylinder><radius>0.195</radius><length>0.125</length></cylinder></geometry>
      </visual>
      <collision name="caster_front">
        <pose>0.15 0 0.025 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <collision name="caster_back">
        <pose>-0.15 0 0.025 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <collision name="mast">
        <pose>-0.015 0 0.3975 0 0 0</pose>
        <geometry><cylinder><radius>0.0125</radius><length>0.445</length></cylinder></geometry>
      </collision>
      <visual name="mast">
        <pose>-0.015 0 0.3975 0 0 0</pose>
        <geometry><cylinder><radius>0.0125</radius><length>0.445</length></cylinder></geometry>
      </visual>
      <collision name="head">
        <pose>0 0 0.5775 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.085</size></box></geometry>
      </collision>
      <visual name="head">
        <pose>0 0 0.5775 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.085</size></box></geometry>
      </visual>
      <collision name="urg">
        <pose>-0.015 0 0.653 0 0 0</pose>
        <geometry><cylinder><radius>0.021</radius><length>0.07</length></cylinder></geometry>
      </collision>
      <visual name="urg_body">
        <pose>-0.015 0 0.64 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.044</size></box></geometry>
      </visual>
      <visual name="urg_top">
        <pose>-0.015 0 0.683 0 0 0</pose>
        <geometry><cylinder><radius>0.021</radius><length>0.01</length></cylinder></geometry>
      </visual>
      <collision name="d435i">
        <pose>0.0455 -0.04175 0.6495 0 0 0</pose>
        <geometry><box><size>0.025 0.09 0.025</size></box></geometry>
      </collision>
      <visual name="d435i">
        <pose>0.0455 -0.04175 0.6495 0 0 0</pose>
        <geometry><box><size>0.025 0.09 0.025</size></box></geometry>
      </visual>
      <sensor name="imu" type="imu">
        <pose>0.0455 -0.04175 0.6495 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
      <sensor name="urg_04lx" type="gpu_lidar">
        <pose>-0.015 0 0.67 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <ray>
          <scan><horizontal><samples>683</samples><resolution>1</resolution>
            <min_angle>-2.0923497677</min_angle><max_angle>2.0923497677</max_angle></horizontal></scan>
          <range><min>0.02</min><max>5.6</max><resolution>0.001</resolution></range>
          <!-- шум как у лидара TurtleBot3 (паспорт URG: ±30 мм до 1 м, ±3 % дальше) -->
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
      </sensor>
    </link>
    <link name="wheel_left_link">
      <pose>0 0.19 0.036 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>3.85e-5</ixx><iyy>3.85e-5</iyy><izz>6.48e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="wheel">
        <geometry><cylinder><radius>0.036</radius><length>0.027</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><ode><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="wheel">
        <geometry><cylinder><radius>0.036</radius><length>0.027</length></cylinder></geometry>
      </visual>
    </link>
    <link name="wheel_right_link">
      <pose>0 -0.19 0.036 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>3.85e-5</ixx><iyy>3.85e-5</iyy><izz>6.48e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="wheel">
        <geometry><cylinder><radius>0.036</radius><length>0.027</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><ode><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="wheel">
        <geometry><cylinder><radius>0.036</radius><length>0.027</length></cylinder></geometry>
      </visual>
    </link>
    <!-- Усилие мотора JGB37-520 на валу колеса — оценка, ≈2 Н·м. -->
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis><xyz>0 0 1</xyz><limit><effort>2</effort></limit></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis><xyz>0 0 1</xyz><limit><effort>2</effort></limit></axis>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.38</wheel_separation>
      <wheel_radius>0.036</wheel_radius>
      <!-- как у TurtleBot3: разгон робота неизвестен, пределы задаёт stm32_sim -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>50</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </model>
</sdf>
