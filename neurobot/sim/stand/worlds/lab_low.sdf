<?xml version="1.0"?>
<!-- Мир lab_low — отрицательные сценарии стенда neurobot для базы NeuroChip (README §2, R7b RS1): препятствия, которые
     не пересекают плоскость скана URG (≈0,67 м), поэтому лидар их не видит и робот в них въезжает. Это показ
     ограничения, а не проверка стража. Комната, стены, столбик и физика — как в lab_wall.sdf, без box_left.
     Три полосы, робот спавнится в x = 0 лицом по +x; полосу задаёт y спавна (флаг y у stand.sh up):
       y = 0    neg_box   — ящик 0,3 × 0,3 × 0,3 м, ближняя грань x = 0,65: упирается палуба;
       y = +1   neg_shelf — полка на 0,49–0,51 м (ножки по бокам, ниже плоскости скана), грань x = 0,65: бьёт мачта;
       y = −1   neg_table — столешница 0,68–0,71 м (выше плоскости, ниже верха URG 0,688), грань x = 0,65: бьёт
                голова URG; ножки 0,68 м по углам — их лидар видит (пеленг ≈29°). -->
<sdf version="1.6">
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><shadows>false</shadows></scene>
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>150</iters><precon_iters>0</precon_iters><sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling></solver>
        <constraints><cfm>0.00001</cfm><erp>0.2</erp><contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer></constraints>
      </ode>
    </physics>
    <light type="directional" name="sun"><cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></visual>
    </link></model>
    <model name="wall_front"><static>true</static><pose>1.55 0 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.1 4.2 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.1 4.2 1.0</size></box></geometry></visual></link></model>
    <model name="wall_back"><static>true</static><pose>-2.55 0 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.1 4.2 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.1 4.2 1.0</size></box></geometry></visual></link></model>
    <model name="wall_left"><static>true</static><pose>-0.5 2.05 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></visual></link></model>
    <model name="wall_right"><static>true</static><pose>-0.5 -2.05 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>4.2 0.1 1.0</size></box></geometry></visual></link></model>
    <model name="post_back"><static>true</static><pose>-0.6 0 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></visual></link></model>
    <model name="neg_box"><static>true</static><pose>0.8 0 0.15 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></visual></link></model>
    <model name="neg_shelf"><static>true</static><pose>0.8 1.0 0 0 0 0</pose>
      <link name="board"><pose>0 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 0.7 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.7 0.02</size></box></geometry></visual></link>
      <link name="leg_left"><pose>0 0.33 0.245 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.03 0.03 0.49</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.03 0.03 0.49</size></box></geometry></visual></link>
      <link name="leg_right"><pose>0 -0.33 0.245 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.03 0.03 0.49</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.03 0.03 0.49</size></box></geometry></visual></link></model>
    <model name="neg_table"><static>true</static><pose>0.95 -1.0 0 0 0 0</pose>
      <link name="top"><pose>0 0 0.695 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 0.8 0.03</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.8 0.03</size></box></geometry></visual></link>
      <link name="leg_fl"><pose>-0.28 0.38 0.34 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.68</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.68</size></box></geometry></visual></link>
      <link name="leg_fr"><pose>-0.28 -0.38 0.34 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.68</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.68</size></box></geometry></visual></link>
      <link name="leg_bl"><pose>0.28 0.38 0.34 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.68</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.68</size></box></geometry></visual></link>
      <link name="leg_br"><pose>0.28 -0.38 0.34 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.68</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.68</size></box></geometry></visual></link></model>
  </world>
</sdf>
